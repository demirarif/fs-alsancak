{
  "name": "alsancak-match-preview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "import:catalog": "node --experimental-strip-types scripts/import-catalog.mjs",
    "check:catalog": "node --experimental-strip-types scripts/import-catalog.mjs --check",
    "test:catalog": "node --experimental-strip-types tests/catalog.test.mjs",
    "test:guests": "node --experimental-strip-types tests/guest-player.test.mjs",
    "test:selection": "node --experimental-strip-types tests/selection.test.mjs",
    "test:lineups": "node --experimental-strip-types tests/lineup.test.mjs",
    "test:camera": "node --experimental-strip-types tests/camera.test.mjs",
    "check:architecture": "tsc --project tsconfig.architecture.json --noEmit",
    "prebuild": "npm run check:catalog",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:appearance": "node --experimental-strip-types tests/appearance.test.mjs",
    "test:engine": "node --experimental-strip-types tests/engine.test.mjs",
    "test:highlights": "node --experimental-strip-types tests/highlight.test.mjs",
    "test:worker": "node --experimental-transform-types tests/worker.test.mjs",
    "calibrate:engine": "node --experimental-strip-types scripts/calibrate-engine.mjs"
  },
  "dependencies": {
    "three": "0.187.0",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.7",
    "typescript": "7.0.2"
  }
}
